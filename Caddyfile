# Servidor interno do front (porta 80, sem TLS).
# O HTTPS e o roteamento de /api/* ficam no Caddy do stack da VPS (/opt/stack/Caddyfile).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Assets com hash no nome: cache longo.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA: qualquer rota cai no index.html (sem cache, para pegar deploys novos).
	@spa not path /assets/*
	header @spa Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
